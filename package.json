{
  "name": "masterflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MasterFlow — OS pédagogique à personas fusionnables (client MALEX). Monorepo backend-first.",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/masterbuild",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/backend",
    "dev:backend": "npm run dev --workspace apps/backend",
    "dev:frontend": "node scripts/dev-frontend-with-masterbuild.mjs",
    "dev:frontend:standalone": "npm run dev --workspace @masterflow/frontend",
    "dev:masterbuild": "npm run dev --workspace @masterflow/masterbuild",
    "masterbuild:boot": "npm run boot --workspace @masterflow/masterbuild",
    "masterbuild:doctor": "npm run doctor --workspace @masterflow/masterbuild",
    "masterbuild:resume": "npm run resume --workspace @masterflow/masterbuild",
    "masterbuild:export": "npm run export --workspace @masterflow/masterbuild",
    "masterbuild:preflight": "npm run preflight --workspace @masterflow/masterbuild --",
    "masterbuild:ui-gate": "npm run ui-gate --workspace @masterflow/masterbuild --",
    "masterbuild:handoff": "npm run handoff --workspace @masterflow/masterbuild",
    "test:masterbuild": "npm run test --workspace @masterflow/masterbuild",
    "build:masterbuild": "npm run test:masterbuild && npm run lint --workspace @masterflow/masterbuild && npm run build --workspace @masterflow/masterbuild",
    "seed": "npm run seed --workspace apps/backend",
    "test": "npm run test --workspace apps/backend",
    "lint": "npm run lint --workspace apps/backend",
    "lint:frontend": "npm run lint --workspace @masterflow/frontend",
    "build:frontend": "npm run build --workspace @masterflow/frontend",
    "smoke:public": "node scripts/smoke-public-runtime.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9"
  }
}
