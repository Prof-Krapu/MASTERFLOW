      "avoid": ["Dashboard permanent", "Catalogue brut de boutons"],
      "checks": ["human", "component_lab"],
      "exceptions": ["Godmode chargé explicitement"],
      "review_owner": "malex"
    },
    {
      "rule_id": "DES-002",
      "title": "Révélation progressive par contexte et loadout",
      "status": "canon",
