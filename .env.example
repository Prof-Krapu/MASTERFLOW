# === API_manage — variables d'environnement ===
# Copier en `.env` (gitignored) et remplir les valeurs.

# --- Sessions (obligatoire) ---
# Générer avec : openssl rand -base64 32
# Doit faire au moins 32 caractères.
SESSION_SECRET=change-me-please-with-a-long-random-string-32chars-min

# --- Chiffrement at-rest des secrets (optionnel) ---
# Les clés API (global_settings.corrector_api_key) sont chiffrées en base
# (AES-256-GCM) avec une clé dérivée de STORAGE_ENC_SECRET, ou à défaut de
# SESSION_SECRET. Définir STORAGE_ENC_SECRET permet de faire tourner
# SESSION_SECRET (déconnexion des sessions) SANS invalider les secrets stockés.
# ATTENTION : si le secret utilisé change, les clés chiffrées deviennent
# illisibles → relancer seed-mistral/seed-albert ou re-saisir les clés en admin.
# STORAGE_ENC_SECRET=

# --- Test de clé admin : hôtes supplémentaires (optionnel) ---
# Le bouton « Tester la clé » ne sonde que les fournisseurs connus (anti-SSRF).
# Fournisseur personnalisé : ajouter son hôte ici (csv, sous-domaines inclus).
# PROBE_ALLOWED_HOSTS=mon-llm.example.org

# --- Compte admin seed (obligatoire au premier boot) ---
# Au démarrage, server/seed.ts crée ce compte s'il n'existe pas,
# ou met à jour son mot de passe s'il existe déjà avec un autre.
ADMIN_USERNAME=vincent
ADMIN_PASSWORD=changer-au-premier-boot

# --- Ports ---
# PORT     : port Express. En dev : 3100 (proxy Vite :3000 → :3100). En prod : 3000.
# SERVER_PORT (Vite) : port utilisé par le proxy Vite en dev pour atteindre Express.
PORT=3100
SERVER_PORT=3100

# --- Ports des sous-apps (cibles du reverse proxy) ---
# Doivent matcher les `PORT=` passés à `npm run serve:web` dans chaque fork.
SUBAPP_PC_PORT=3001
SUBAPP_FR_PORT=3005
SUBAPP_NL_PORT=3009

# --- Divers ---
# Mettre `true` pour désactiver le HMR Vite en dev (utile en démo).
DISABLE_HMR=false
