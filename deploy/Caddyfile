{
  # Le TLS est termine par le reverse proxy ou le tunnel choisi par l'operateur.
  auto_https off
}

:80 {
  encode zstd gzip

  @mutable_shell path / /index.html /sw.js
  header @mutable_shell Cache-Control "no-cache, no-store, must-revalidate"

  @hashed_assets path /assets/*
  header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

  # Une seule origine pour le navigateur : REST et WebSocket traversent le meme proxy.
  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /ws/* {
    reverse_proxy backend:8000
  }

  handle /health {
    reverse_proxy backend:8000
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}
